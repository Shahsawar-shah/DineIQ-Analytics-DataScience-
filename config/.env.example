# Copy to config/.env and fill in real values. config/.env is git-ignored.
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/dineiq_analytics
SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
PARQUET_DATA_PATH=../parquet_data/
MODELS_PATH=../models/
# Allowed browser origins for the API (comma separated)
CORS_ORIGINS=http://localhost:5173
# Password given to the demo accounts by scripts/create_demo_accounts.py
DEMO_ACCOUNT_PASSWORD=Demo@12345
