      {
        "name": "_Measures",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "x",
            "dataType": "int64",
            "isHidden": true,
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[x]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"x\", 0)"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "CALCULATE(SUM(fact_order_items[revenue]), fact_order_items[is_cancelled] = FALSE())",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Total Cost",
            "expression": "CALCULATE(SUM(fact_order_items[cost]), fact_order_items[is_cancelled] = FALSE())",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Gross Profit",
            "expression": "[Total Revenue] - [Total Cost]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Gross Profit], [Total Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Sales"
          },
          {
            "name": "Units Sold",
            "expression": "CALCULATE(SUM(fact_order_items[quantity]), fact_order_items[is_cancelled] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Total Orders",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_orders[order_id]), fact_orders[is_cancelled] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "Sales"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE([Total Revenue], [Total Orders])",
            "formatString": "\\$#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "Avg Basket Size",
            "expression": "AVERAGE(fact_orders[basket_size])",
            "formatString": "#,0.00",
            "displayFolder": "Sales"
          },
          {
            "name": "Cancellation Rate",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fact_orders), fact_orders[is_cancelled] = TRUE()), COUNTROWS(fact_orders))",
            "formatString": "0.00%",
            "displayFolder": "Sales"
          },
          {
            "name": "Revenue MoM %",
            "expression": "VAR prev = CALCULATE([Total Revenue], DATEADD(dim_date[date], -1, MONTH)) RETURN DIVIDE([Total Revenue] - prev, prev)",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Revenue MTD",
            "expression": "TOTALMTD([Total Revenue], dim_date[date])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Customer Count",
            "expression": "COUNTROWS(dim_customer)",
            "formatString": "#,0",
            "displayFolder": "Customers"
          },
          {
            "name": "Active Customers",
            "expression": "CALCULATE(DISTINCTCOUNT(fact_orders[customer_id]), fact_orders[is_cancelled] = FALSE())",
            "formatString": "#,0",
            "displayFolder": "Customers"
          },
          {
            "name": "At-Risk Customers",
            "expression": "CALCULATE(COUNTROWS(dim_customer), dim_customer[churn_status] = \"At Risk\")",
            "formatString": "#,0",
            "displayFolder": "Customers"
          },
          {
            "name": "Churn Risk %",
            "expression": "DIVIDE([At-Risk Customers], [Customer Count])",
            "formatString": "0.0%",
            "displayFolder": "Customers"
          },
          {
            "name": "Avg RFM Score",
            "expression": "AVERAGE(dim_customer[rfm_score])",
            "formatString": "#,0.00",
            "displayFolder": "Customers"
          },
          {
            "name": "Discount Given",
            "expression": "CALCULATE(SUM(fact_orders[discount_amount]), fact_orders[is_cancelled] = FALSE())",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Promotions"
          },
          {
            "name": "Promo Revenue",
            "expression": "CALCULATE([Total Revenue], fact_order_items[promotion_id] <> 0)",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Promotions"
          },
          {
            "name": "Promo Share %",
            "expression": "DIVIDE([Promo Revenue], [Total Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Promotions"
          },
          {
            "name": "Promo ROI",
            "expression": "DIVIDE([Promo Revenue] - [Discount Given], [Discount Given])",
            "formatString": "0.00\"x\"",
            "displayFolder": "Promotions"
          },
          {
            "name": "Promo Orders",
            "expression": "CALCULATE([Total Orders], fact_orders[promotion_id] <> 0)",
            "formatString": "#,0",
            "displayFolder": "Promotions"
          },
          {
            "name": "Wastage Cost",
            "expression": "SUM(fact_wastage[wastage_cost])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Wastage"
          },
          {
            "name": "Wastage Qty",
            "expression": "SUM(fact_wastage[wastage_quantity])",
            "formatString": "#,0",
            "displayFolder": "Wastage"
          },
          {
            "name": "Wastage % of Cost",
            "expression": "DIVIDE([Wastage Cost], [Total Cost])",
            "formatString": "0.00%",
            "displayFolder": "Wastage"
          },
          {
            "name": "Avg Rating",
            "expression": "AVERAGE(fact_ratings[rating_value])",
            "formatString": "0.00",
            "displayFolder": "Ratings"
          },
          {
            "name": "Rating Count",
            "expression": "COUNTROWS(fact_ratings)",
            "formatString": "#,0",
            "displayFolder": "Ratings"
          },
          {
            "name": "Stock Value",
            "expression": "SUM(fact_inventory[stock_value])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Inventory"
          },
          {
            "name": "Items To Reorder",
            "expression": "CALCULATE(COUNTROWS(fact_inventory), fact_inventory[needs_reorder] = TRUE())",
            "formatString": "#,0",
            "displayFolder": "Inventory"
          },
          {
            "name": "Item Count",
            "expression": "COUNTROWS(dim_menu_item)",
            "formatString": "#,0",
            "displayFolder": "ML"
          },
          {
            "name": "Correct Predictions",
            "expression": "COUNTROWS(FILTER(dim_menu_item, dim_menu_item[menu_class] = dim_menu_item[predicted_class]))",
            "formatString": "#,0",
            "displayFolder": "ML"
          },
          {
            "name": "Prediction Accuracy",
            "expression": "DIVIDE([Correct Predictions], [Item Count])",
            "formatString": "0.0%",
            "displayFolder": "ML"
          },
          {
            "name": "Precision",
            "expression": "DIVIDE([Correct Predictions], [Item Count])",
            "formatString": "0.0%",
            "displayFolder": "ML"
          },
          {
            "name": "Recall",
            "expression": "DIVIDE([Correct Predictions], [Item Count])",
            "formatString": "0.0%",
            "displayFolder": "ML"
          },
          {
            "name": "Avg Confidence",
            "expression": "AVERAGE(dim_menu_item[prediction_confidence])",
            "formatString": "0.0%",
            "displayFolder": "ML"
          },
          {
            "name": "Metric Value",
            "expression": "SUM(model_metrics[value])",
            "formatString": "0.0000",
            "displayFolder": "ML"
          }
        ]
      }
    ],
